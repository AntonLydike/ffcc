// RUN: ffcc-opt %s -p approx{exp},simp,cse | filecheck %s

%x = var x : f32
%e = constant e : f32
%xs = mul %x, %x : f32
%mxs = negate %xs : f32
%r = pow %e, %mxs : f32

// CHECK:      %s1 = tunable 's1' = 1064988300.0 : f32
// CHECK-NEXT: %0 = constant -12102203.0 : f32
// CHECK-NEXT: %x = var 'x' : f32
// CHECK-NEXT: %xs = mul %x, %x : f32
// CHECK-NEXT: %1 = mul %0, %xs : f32
// CHECK-NEXT: %2 = add %s1, %1 : f32
// CHECK-NEXT: %3 = bitcast i2f %2 to f32
