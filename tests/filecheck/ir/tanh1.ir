// RUN: ffcc-opt -p approx{exp},simp,cse %s | filecheck %s --match-full-lines
// RUN: ffcc-opt -p approx{exp},simp,cse %s -f llvm | opt -S | filecheck %s --check-prefix=LLVM --match-full-lines

// ex = e^-x
// emx = 1/emx
// res = (ex - emx) / (ex + emx)
%x = var x : f32
%one = constant 1 : f32
%e = constant e : f32
%ex = pow %e, %x : f32
%emx = div %one, %ex : f32
%top = sub %ex, %emx : f32
%btm = add %ex, %emx : f32
%res = div %top, %btm : f32

// CHECK-NEXT: %s1 = tunable 's1' = 1064988300.0 : f32
// CHECK-NEXT: %0 = constant 12102203.0 : f32
// CHECK-NEXT: %x = var 'x' : f32
// CHECK-NEXT: %1 = mul %0, %x : f32
// CHECK-NEXT: %2 = add %s1, %1 : f32
// CHECK-NEXT: %3 = bitcast i2f %2 to f32
// CHECK-NEXT: %one = constant 1 : f32
// CHECK-NEXT: %emx = div %one, %3 : f32
// CHECK-NEXT: %top = sub %3, %emx : f32
// CHECK-NEXT: %btm = add %3, %emx : f32
// CHECK-NEXT: %res = div %top, %btm : f32

// LLVM-NEXT: ; ModuleID = '<stdin>'
// LLVM-NEXT: source_filename = "<stdin>"
// LLVM-EMPTY:
// LLVM-NEXT: define float @my_func(float %x, float %s1) {
// LLVM-NEXT:   %1 = fmul float 0x4167154760000000, %x
// LLVM-NEXT:   %2 = fadd float %s1, %1
// LLVM-NEXT:   %cast = fptosi float %2 to i32
// LLVM-NEXT:   %3 = bitcast i32 %cast to float
// LLVM-NEXT:   %emx = fdiv float 1.000000e+00, %3
// LLVM-NEXT:   %top = fsub float %3, %emx
// LLVM-NEXT:   %btm = fadd float %3, %emx
// LLVM-NEXT:   %res = fdiv float %top, %btm
// LLVM-NEXT:   ret float %res
// LLVM-NEXT: }
