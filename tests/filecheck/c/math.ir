// RUN: ffcc-opt %s -f c | filecheck %s
// RUN: ffcc-opt %s -f c | clang -x c - -fsyntax-only -Wall -Wextra -

%x = var 'x' : f64
%two = constant 2 : f64
%onep5 = constant 1.5 : f64
%l = log %x, %two : f64
%p = pow %x, %two : f64
%s1 = add %l, %p : f64
%s = add %s1, %onep5 : f64
%c = cast %s to i32
%r = add %c, %two : f64

// CHECK:      #include <math.h>
// CHECK:      double fast_function(double x)
// CHECK-NEXT: {
// CHECK:      int32_t v0 = (int32_t)(((log2(x) + pow(x, 2)) + 1.5));
// CHECK:      return ((double)(v0) + 2);
// CHECK:      }
